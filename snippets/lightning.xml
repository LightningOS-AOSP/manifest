<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="lightning"
           fetch="https://github.com/LightningOS-AOSP"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/1.1" />

  <remote  name="lightning-device"
           fetch="https://github.com/LightningOS-Devices"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/1.1" />
  
  <remote  name="gitlab"
           sync-c="true"
           sync-j="4"
           fetch="https://gitlab.com" />

  <remote  name="github-non-los"
           sync-c="true"
           sync-j="4"
           fetch="https://github.com" />

  <remote  name="lightning-codeberg"
           fetch="https://codeberg.org/MODEDGES"
           sync-c="true"
           sync-j="4"
           depth="1"
           revision="refs/heads/1.1" />


   <!-- Art -->
  <project path="art" name="art" groups="pdk" remote="lightning" />

  <!-- Bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="lightning" />

  <!-- Bootable -->
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="lightning" />

  <!-- Build -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="lightning" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="lightning" />

  <!-- External -->
  <project path="external/FadingEdgeLayout" name="external_FadingEdgeLayout" remote="lightning" />
  <project path="external/bouncycastle" name="external_bouncycastle" remote="lightning" />
  <project path="external/piex" name="external_piex" groups="pdk" remote="lightning" />

